# Copy this file to .env and fill in real values. .env is gitignored.

# OpenAI-compatible LLM server (llama-server, vLLM, etc.).
# On Barkla this is typically a compute node reached through an SSH tunnel:
#   ssh -L 8080:<compute-node-hostname>:8080 <user>@barkla.liverpool.ac.uk
# then leave this pointed at localhost. See scripts/slurm/run_llm_server.sbatch.
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=not-needed
LLM_MODEL=gemma-4-12b-it
LLM_TEMPERATURE=0.2

# https://www.semanticscholar.org/product/api#api-key
SEMANTIC_SCHOLAR_API_KEY=

MAX_RESULTS_PER_QUERY=5

# Hypothesis Agent
HYPOTHESIS_OUTPUT_DIR=outputs
HYPOTHESIS_BATCH_MAX_CHARS=12000

# Experiment Planner Agent
EXPERIMENT_PLANNER_OUTPUT_DIR=outputs

# Coder Agent
CODER_EXPERIMENTS_DIR=experiments
CODER_OUTPUT_DIR=outputs

# Writer Agent
WRITER_OUTPUT_DIR=outputs
WRITER_RELATED_WORK_BATCH_MAX_CHARS=12000
# No author identity flows through the pipeline, so the paper defaults to
# NeurIPS's own anonymized-submission placeholder text. Set these to
# de-anonymize the PDF.
WRITER_PAPER_AUTHORS=Anonymous Author(s)
WRITER_PAPER_AFFILIATION=Anonymous Institution

# Reviewer Agent (standalone use)
REVIEWER_OUTPUT_DIR=outputs

# Writer/Reviewer feedback loop
WRITER_REVIEWER_LOOP_OUTPUT_DIR=outputs/paper
WRITER_REVIEWER_MAX_ITERATIONS=3
WRITER_REVIEWER_QUALITY_THRESHOLD=4
