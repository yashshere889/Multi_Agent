# Copy this file to .env and fill in real values. .env is gitignored.

# How the model is reached. Two options:
#   openai      (default) call an OpenAI-compatible server over LLM_BASE_URL.
#   huggingface load the model in-process with transformers — no server, no
#               port, no health check. Needs `uv sync --extra huggingface`.
#               On Barkla this matches the cluster's own nemotron/nano-12b-v2
#               module. Slower than vLLM, and LLM_BASE_URL/LLM_API_KEY are
#               unused; see the notes on LLM_ENABLE_THINKING below.
LLM_BACKEND=openai

# OpenAI-compatible LLM server. The pipeline targets NVIDIA Nemotron 3 Nano
# served by vLLM: https://huggingface.co/nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-BF16
# On Barkla this is typically a compute node reached through an SSH tunnel:
#   ssh -L 8080:<compute-node-hostname>:8080 <user>@barkla.liverpool.ac.uk
# then leave this pointed at localhost. See scripts/slurm/run_llm_server.sbatch.
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=not-needed
# Must match the id the server advertises. run_llm_server.sbatch passes no
# --served-model-name, so that's the full HF repo id below; if you launch vLLM
# with `--served-model-name model` (as the model card's example does), set this
# to `model` instead.
LLM_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-BF16
# Low temperature because every agent is parsing structured JSON or drafting
# from fixed upstream facts. Nemotron's card recommends 1.0/1.0 for reasoning
# tasks and 0.6/0.95 for tool calling — raise these if you turn thinking on.
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.95
# Response budget. A truncated completion is a hard failure (unparseable JSON /
# a half-written paper section), so leave headroom — much more if thinking is on.
LLM_MAX_TOKENS=8192

# Nemotron 3 Nano reasons before answering, emitting a <think>...</think> trace.
# Off by default: nothing in this pipeline consumes reasoning traces, and they
# cost tokens and latency on every one of the ~dozens of calls a full run makes.
# Traces are stripped defensively either way (llm_json.strip_reasoning), so
# turning this on is safe even on a server started without vLLM's nano_v3
# reasoning parser.
#
# LLM_BACKEND=huggingface cannot send this (it's an OpenAI wire-protocol field
# and there is no request body), so the model decides for itself and the
# setting is logged and ignored. strip_reasoning is the only guard there.
LLM_ENABLE_THINKING=false
# Caps reasoning tokens when thinking is on; ignored when it's off. Blank = no cap.
# Also openai-backend only, for the same reason.
LLM_REASONING_BUDGET=

# huggingface backend only. device_map="auto" lets accelerate shard the model
# across whatever GPUs SLURM allocated. dtype="auto" takes the checkpoint's own
# precision (BF16 for these models) — set "float16" on pre-Ampere GPUs, which
# have no bfloat16 (on Barkla that means the gpu-v100 partition).
LLM_HF_DEVICE_MAP=auto
LLM_HF_DTYPE=auto

# https://www.semanticscholar.org/product/api#api-key
SEMANTIC_SCHOLAR_API_KEY=

MAX_RESULTS_PER_QUERY=5

# Hypothesis Agent
HYPOTHESIS_OUTPUT_DIR=outputs
HYPOTHESIS_BATCH_MAX_CHARS=12000

# Experiment Planner Agent
EXPERIMENT_PLANNER_OUTPUT_DIR=outputs

# Coder Agent
CODER_EXPERIMENTS_DIR=experiments
CODER_OUTPUT_DIR=outputs

# Writer Agent
WRITER_OUTPUT_DIR=outputs
WRITER_RELATED_WORK_BATCH_MAX_CHARS=12000
# No author identity flows through the pipeline, so the paper defaults to
# NeurIPS's own anonymized-submission placeholder text. Set these to
# de-anonymize the PDF.
WRITER_PAPER_AUTHORS=Anonymous Author(s)
WRITER_PAPER_AFFILIATION=Anonymous Institution

# Reviewer Agent (standalone use)
REVIEWER_OUTPUT_DIR=outputs

# Writer/Reviewer feedback loop
WRITER_REVIEWER_LOOP_OUTPUT_DIR=outputs/paper
WRITER_REVIEWER_MAX_ITERATIONS=3
WRITER_REVIEWER_QUALITY_THRESHOLD=4
