#!/bin/bash
# Auto-generated by the Coder Agent for hypothesis {hypothesis_id}.
# estimated_complexity was "high" (or the experiment needs a GPU this
# environment doesn't have), so this was NOT run synchronously and has NOT
# been submitted — review it, then submit yourself with:
#   sbatch run.sbatch
# Adjust the module/time TODOs first, and submit from scratch or fastscratch
# (Barkla's storage guide says not to submit jobs from home/data/localscratch).

#SBATCH --job-name=experiment-{hypothesis_id}
# Barkla GPU partitions open to all users:
#   gpu-h100  4x H100 80GB, 3-day limit
#   gpu-l40s  2x L40S 48GB, 3-day limit
#   gpu-v100  4x V100 16GB, 3-day limit (Volta: no bfloat16)
# Low priority, 1-day limit, pre-empted and requeued when the owning group
# submits — fine for restartable work, bad for a long single run:
#   gpu-a100-lowbig  4x A100 80GB
#   gpu-a-lowsmall   2x A100 80GB / 2x A40 48GB
#SBATCH --partition=gpu-l40s
#SBATCH --gres=gpu:1               # TODO: remove this line if the experiment doesn't need a GPU
#SBATCH --nodes=1
#SBATCH --time=24:00:00            # TODO: adjust to a realistic bound for this experiment
#SBATCH --output=run_%j.log
# Requeue this job if it is preempted or the node fails, and append to the log
# rather than truncating it, so the requeued attempt does not erase the record
# of the one it is continuing. A requeued job keeps its id, hence the same file.
#SBATCH --requeue
#SBATCH --open-mode=append

# Deliberately no --cpus-per-task / --mem: on Barkla both are allocated
# automatically from the number of GPUs requested.

set -euo pipefail
module purge
module load python                 # TODO: match an available `module avail python` entry
                                   # (the default system python is 3.9.21)

cd "$(dirname "$0")"
# --resume continues from the last checkpoint run.py wrote, and does nothing at
# all on the first attempt (there is no checkpoint to find yet). That is what
# makes it correct as the only command here: a job preempted off one of the
# low-priority partitions above is requeued and picks up where it stopped,
# instead of starting the experiment over and usually never finishing. An
# experiment with no training loop simply never writes a checkpoint and reruns
# from the top, exactly as it would have without the flag.
{venv_activation}python run.py --resume
