#SBATCH --nodes=1
#SBATCH --time=24:00:00            # TODO: adjust to a realistic bound for this experiment
#SBATCH --output=run_%j.log

# Deliberately no --cpus-per-task / --mem: on Barkla both are allocated
# automatically from the number of GPUs requested.

set -euo pipefail
module purge
module load python                 # TODO: match an available `module avail python` entry
                                   # (the default system python is 3.9.21)

cd "$(dirname "$0")"
{venv_activation}python run.py
